// module z link "z" { ... }: the module names the library its externs
// come from, so the JIT opens it with no -l, and looks each one up in it.
// zlib is not in occultc's own process, so this passes only if the module
// really loaded it. A nested module without a link of its own inherits
// the outer one; "libz" and "z" are the same library, as -lz is.
// Prints PASS.

extern fn printf(i64 fmt, ...) i32;

module z link "z" {
    extern fn compressBound(i64 n) i64;

    module info {
        extern fn zlibVersion() i64;
    }
}

module zlib link "libz" {
    extern fn compressBound(i64 n) i64;
}

fn main() i64 {
    i64 bad = 0;

    // sourceLen + (sourceLen >> 12) + (sourceLen >> 14) + (sourceLen >> 25) + 13
    if z::compressBound(1000) != 1013 { bad += 1; printf("compressBound\n"); }
    if $(u8*(z::info::zlibVersion())) != 49 { bad += 1; printf("nested module\n"); }   // '1'
    if zlib::compressBound(0) != 13 { bad += 1; printf("lib prefix\n"); }

    if bad == 0 { printf("PASS\n"); }

    return bad;
}
