include "../std/stdio.occ"
include "../std/vec.occ"

fn main() i64 {
    // vector_new is the constructor the module has: it allocates the
    // Vector as well as its storage. `vector_construct`, which these
    // tests called, is not defined anywhere in std -- so they have
    // never got past the linter.
    std::Vector<i64>* v = std::vector_new<i64>(8, 4);

    for i64 i = 0 when i < 100 do i += 10 {
        std::vector_push_back<i64>(v, i);
    }

    std::printf("Vec elements: ");
    i64 i = 0;
    while i < v.length {
        std::printf("%i ", std::vector_at<i64>(v, i));
        i += 1;
    }
    std::printf("\n");

    std::printf("Length: %i\n", v.length);
    std::printf("Capacity: %i\n", v.capacity);

    std::vector_free<i64>(v);
    std::free(v);
    return 0;
}
